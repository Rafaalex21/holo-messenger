{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Holo-Messenger",
  "version": "1.0.1",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "holo-messenger@rafaalex21.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "scripts": [
      "src/shared/config.js",
      "src/background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/shared/selectors.js",
        "src/content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "src/theme/_fonts.css",
        "src/theme/_tokens.css",
        "src/theme/_utils.css",
        "src/theme/_base.css",
        "src/theme/_sidebar.css",
        "src/theme/_conversation.css",
        "src/theme/_composer.css",
        "src/theme/_overlays.css",
        "src/theme/_fx.css"
      ],
      "js": [
        "src/shared/config.js",
        "src/shared/selectors.js",
        "src/content/content.js",
        "src/content/sound.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/*.woff2"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Holo-Messenger",
    "default_popup": "src/popup/popup.html",
    "default_icon": "assets/icons/icon.svg"
  },
  "icons": {
    "48": "assets/icons/icon.svg",
    "96": "assets/icons/icon.svg"
  }
}
