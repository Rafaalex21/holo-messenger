{
  "name": "holo-messenger",
  "version": "0.1.0",
  "private": true,
  "description": "Tema estilo Cyberpunk 2077 e som de notificação personalizado para o WhatsApp Web (extensão Firefox).",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "web-ext run --start-url https://web.whatsapp.com",
    "dev:devedition": "web-ext run --firefox=firefoxdeveloperedition --start-url https://web.whatsapp.com",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "test": "playwright test"
  },
  "webExt": {
    "sourceDir": ".",
    "ignoreFiles": [
      "docs",
      "tests",
      "scripts",
      "spec.md",
      "README.md",
      "package.json",
      "package-lock.json",
      "playwright.config.*",
      "test-results",
      "playwright-report",
      "**/.gitkeep"
    ]
  }
}
