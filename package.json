{
  "name": "holo-messenger",
  "version": "0.1.0",
  "private": true,
  "description": "Tema estilo Cyberpunk 2077 e som de notificação personalizado para o WhatsApp Web (extensão Firefox).",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/run-firefox.mjs .",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "test": "playwright test",
    "prepare": "git config core.hooksPath .githooks",
    "recon": "node scripts/run-firefox.mjs scripts/recon/ext --no-reload",
    "contrast": "node scripts/check-contrast.mjs",
    "fixtures": "node scripts/serve-fixtures.mjs"
  },
  "webExt": {
    "sourceDir": ".",
    "ignoreFiles": [
      "docs",
      "tests",
      "scripts",
      "spec.md",
      "README.md",
      "package.json",
      "package-lock.json",
      "playwright.config.*",
      "test-results",
      "playwright-report",
      "**/.gitkeep",
      "web-ext-artifacts"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "web-ext": "^10.8.0"
  }
}
